{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kcrashlab.local/schemas/real-environment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_mode", "guest_build", "driver_sha256", "vm_identity_sha256", "checkpoint_identity_sha256", "authorization_sha256", "symbols_sha256", "recorded_at_utc", "git_commit"],
  "properties": {
    "schema_version": { "const": 1 },
    "execution_mode": { "const": "REAL_LAB" },
    "guest_build": { "type": "string", "minLength": 1, "maxLength": 128 },
    "driver_sha256": { "$ref": "#/$defs/sha256" },
    "vm_identity_sha256": { "$ref": "#/$defs/sha256" },
    "checkpoint_identity_sha256": { "$ref": "#/$defs/sha256" },
    "authorization_sha256": { "$ref": "#/$defs/sha256" },
    "symbols_sha256": { "$ref": "#/$defs/sha256" },
    "recorded_at_utc": { "type": "string", "format": "date-time" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
