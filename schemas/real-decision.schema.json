{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kcrashlab.local/schemas/real-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_mode", "status", "replay_policy", "replays", "limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "execution_mode": { "const": "REAL_LAB" },
    "status": { "const": "CONFIRMED" },
    "replay_policy": { "const": "3/3_COLD_CHECKPOINT" },
    "replays": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["attempt", "classification", "signature", "dump_sha256", "journal_sha256", "watchdog_sha256"],
        "properties": {
          "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
          "classification": { "const": "MATCH" },
          "signature": { "$ref": "#/$defs/sha256" },
          "dump_sha256": { "$ref": "#/$defs/sha256" },
          "journal_sha256": { "$ref": "#/$defs/sha256" },
          "watchdog_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 3, "items": { "type": "string" } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
