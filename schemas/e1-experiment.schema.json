{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kcrashlab.dev/schemas/e1-experiment.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "execution_mode",
    "experiment",
    "seed_case_id",
    "budget_per_trial",
    "trials_per_strategy",
    "base_campaign_seed",
    "provenance",
    "trials",
    "strategies",
    "factorial_contrasts",
    "interpretation",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "execution_mode": {
      "const": "SIMULATED"
    },
    "experiment": {
      "const": "E1_POLICY_ABLATION_2X2_V2"
    },
    "seed_case_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "budget_per_trial": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "trials_per_strategy": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "base_campaign_seed": {
      "type": "integer",
      "minimum": 0
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "trials": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "trial",
          "strategy",
          "campaign_seed",
          "executions",
          "found",
          "first_finding_execution",
          "coverage_count",
          "corpus_count",
          "raw_synthetic_failures",
          "exact_signatures"
        ],
        "properties": {
          "trial": {
            "type": "integer",
            "minimum": 1
          },
          "strategy": {
            "$ref": "#/$defs/strategy"
          },
          "campaign_seed": {
            "type": "integer",
            "minimum": 0
          },
          "executions": {
            "type": "integer",
            "minimum": 1
          },
          "found": {
            "type": "boolean"
          },
          "first_finding_execution": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "coverage_count": {
            "type": "integer",
            "minimum": 1
          },
          "corpus_count": {
            "type": "integer",
            "minimum": 1
          },
          "raw_synthetic_failures": {
            "type": "integer",
            "minimum": 0
          },
          "exact_signatures": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "strategies": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "strategy",
          "trials",
          "discoveries",
          "censored_trials",
          "discovery_rate",
          "median_first_finding_among_discoveries",
          "first_finding_q1_among_discoveries",
          "first_finding_q3_among_discoveries"
        ],
        "properties": {
          "strategy": {
            "$ref": "#/$defs/strategy"
          },
          "trials": {
            "type": "integer",
            "minimum": 1
          },
          "discoveries": {
            "type": "integer",
            "minimum": 0
          },
          "censored_trials": {
            "type": "integer",
            "minimum": 0
          },
          "discovery_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "median_first_finding_among_discoveries": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1
          },
          "first_finding_q1_among_discoveries": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1
          },
          "first_finding_q3_among_discoveries": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "factorial_contrasts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "contrast",
          "left_strategy",
          "right_strategy",
          "both_discovered",
          "left_only",
          "right_only",
          "neither_discovered"
        ],
        "properties": {
          "contrast": {
            "enum": [
              "ADMISSION_AT_UNIFORM_PARENT",
              "ADMISSION_AT_ENERGY_RANKED_PARENT",
              "PARENT_AT_KEEP_ALL_ADMISSION",
              "PARENT_AT_NOVELTY_ADMISSION"
            ]
          },
          "left_strategy": {
            "$ref": "#/$defs/strategy"
          },
          "right_strategy": {
            "$ref": "#/$defs/strategy"
          },
          "both_discovered": {
            "type": "integer",
            "minimum": 0
          },
          "left_only": {
            "type": "integer",
            "minimum": 0
          },
          "right_only": {
            "type": "integer",
            "minimum": 0
          },
          "neither_discovered": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "object",
      "required": [
        "kernel_crashes",
        "real_driver_performance",
        "statistical_significance"
      ],
      "properties": {
        "kernel_crashes": {
          "const": "NOT_CLAIMED"
        },
        "real_driver_performance": {
          "const": "NOT_CLAIMED"
        },
        "statistical_significance": {
          "const": "NOT_ASSESSED"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "strategy": {
      "enum": [
        "KEEP_ALL_UNIFORM_V2",
        "KEEP_ALL_ENERGY_RANKED_V2",
        "NOVELTY_ONLY_UNIFORM_V2",
        "NOVELTY_ONLY_ENERGY_RANKED_V2"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "recorded_at_utc",
        "git_commit",
        "source_tree_digest",
        "source_tree_digest_algorithm",
        "experiment_definition_digest",
        "case_schema_version",
        "engine_version"
      ],
      "properties": {
        "recorded_at_utc": {
          "anyOf": [
            {
              "const": "UNSPECIFIED"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "git_commit": {
          "anyOf": [
            {
              "const": "UNCOMMITTED"
            },
            {
              "type": "string",
              "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
            }
          ]
        },
        "source_tree_digest": {
          "anyOf": [
            {
              "const": "UNSPECIFIED"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "source_tree_digest_algorithm": {
          "enum": [
            "UNSPECIFIED",
            "GIT_TREE_SHA256_V1"
          ]
        },
        "experiment_definition_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "case_schema_version": {
          "const": 1
        },
        "engine_version": {
          "const": "1.4.0-sim"
        },
        "source_commit_time_utc": {
          "anyOf": [
            {
              "const": "UNSPECIFIED"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "reproducible_timestamp_policy": {
          "enum": [
            "UNSPECIFIED",
            "SOURCE_COMMIT_TIME",
            "WALL_CLOCK"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
