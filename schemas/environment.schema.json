{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kcrashlab.dev/schemas/environment.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "execution_mode",
    "backend",
    "simulator_version",
    "virtual_epoch_utc",
    "scenario_fixture"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "execution_mode": { "const": "SIMULATED" },
    "backend": { "const": "SIMULATED_BACKEND_V1" },
    "simulator_version": { "const": "1.0.0" },
    "virtual_epoch_utc": { "const": "2026-08-31T00:00:00.0000000+00:00" },
    "scenario_fixture": {
      "type": "object",
      "required": ["schema_version", "name", "digest_algorithm", "digest"],
      "properties": {
        "schema_version": { "const": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "digest_algorithm": { "const": "SCENARIO_JSON_SHA256_V1" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
