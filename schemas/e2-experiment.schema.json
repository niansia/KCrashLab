{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kcrashlab.dev/schemas/e2-experiment.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "execution_mode",
    "experiment",
    "seed_case_id",
    "budget_per_trial",
    "trials_per_mode",
    "base_campaign_seed",
    "single_call_maximum_sequence_length",
    "stateful_maximum_sequence_length",
    "provenance",
    "trials",
    "modes",
    "paired_outcomes",
    "interpretation",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "execution_mode": {
      "const": "SIMULATED"
    },
    "experiment": {
      "const": "E2_STATEFUL_VS_SINGLE_CALL_V1"
    },
    "seed_case_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "budget_per_trial": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "trials_per_mode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "base_campaign_seed": {
      "type": "integer",
      "minimum": 0
    },
    "single_call_maximum_sequence_length": {
      "const": 1
    },
    "stateful_maximum_sequence_length": {
      "type": "integer",
      "minimum": 2,
      "maximum": 64
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "trials": {
      "type": "array",
      "minItems": 2
    },
    "modes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "paired_outcomes": {
      "type": "object",
      "required": [
        "both_discovered",
        "stateful_only",
        "single_call_only",
        "neither_discovered"
      ],
      "properties": {
        "both_discovered": {
          "type": "integer",
          "minimum": 0
        },
        "stateful_only": {
          "type": "integer",
          "minimum": 0
        },
        "single_call_only": {
          "type": "integer",
          "minimum": 0
        },
        "neither_discovered": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "object",
      "required": [
        "kernel_crashes",
        "real_driver_performance",
        "statistical_significance"
      ],
      "properties": {
        "kernel_crashes": {
          "const": "NOT_CLAIMED"
        },
        "real_driver_performance": {
          "const": "NOT_CLAIMED"
        },
        "statistical_significance": {
          "const": "NOT_ASSESSED"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "recorded_at_utc",
        "git_commit",
        "source_tree_digest",
        "experiment_definition_digest",
        "case_schema_version",
        "engine_version"
      ],
      "properties": {
        "recorded_at_utc": {
          "anyOf": [
            {
              "const": "UNSPECIFIED"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "git_commit": {
          "anyOf": [
            {
              "const": "UNCOMMITTED"
            },
            {
              "type": "string",
              "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
            }
          ]
        },
        "source_tree_digest": {
          "anyOf": [
            {
              "const": "UNSPECIFIED"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "experiment_definition_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "case_schema_version": {
          "const": 1
        },
        "engine_version": {
          "const": "1.4.0-sim"
        },
        "source_commit_time_utc": {
          "anyOf": [
            {
              "const": "UNSPECIFIED"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "reproducible_timestamp_policy": {
          "enum": [
            "UNSPECIFIED",
            "SOURCE_COMMIT_TIME",
            "WALL_CLOCK"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
